{
  "name": "ghatehresan-website",
  "private": true,
  "description": "وب‌سایت قطعه‌رسان — سامانهٔ تأمین و فروش قطعات یدکی خودرو",
  "scripts": {
    "build": "node build.mjs && npx @tailwindcss/cli -i ./src/input.css -o ./public/assets/css/app.css --minify",
    "build:pages": "node build.mjs",
    "dev:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/assets/css/app.css --watch",
    "serve": "python3 -m http.server 8000 -b 0.0.0.0 -d public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
